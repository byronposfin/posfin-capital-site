{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/get-options",
      "destination": "/get-your-options",
      "permanent": false
    },
    {
      "source": "/go/options",
      "destination": "/get-your-options",
      "permanent": false
    },
    {
      "source": "/options",
      "destination": "/get-your-options",
      "permanent": false
    },
    {
      "source": "/development-exit",
      "destination": "/dev-exit",
      "permanent": false
    },
    {
      "source": "/development-exit-finance",
      "destination": "/dev-exit",
      "permanent": false
    },
    {
      "source": "/apply-now",
      "destination": "/apply",
      "permanent": false
    },
    {
      "source": "/go/speed",
      "destination": "/apply/speed",
      "permanent": false
    },
    {
      "source": "/go/bridge",
      "destination": "/apply/bridge",
      "permanent": false
    },
    {
      "source": "/go/dev",
      "destination": "/dev-exit",
      "permanent": false
    },
    {
      "source": "/go/senior",
      "destination": "/senior-desk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/engine/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/staff/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/case/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/staff/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/(works|al|remortgage|lender)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/case/:token/file/:submission", "destination": "/api/case-file?token=:token&submission=:submission" },
    { "source": "/case/:token/submit", "destination": "/api/case-submit?token=:token" },
    { "source": "/case/:token/kyc", "destination": "/api/case-kyc?token=:token" },
    { "source": "/case/:token", "destination": "/api/case-portal?token=:token" },
    { "source": "/staff/set-password", "destination": "/api/staff-set-password" },
    { "source": "/staff/cockpit/live", "destination": "/api/el-lor-desk" },
    { "source": "/staff/cockpit/el/:caseRef", "destination": "/api/el-lor-desk?case=:caseRef" },
    { "source": "/staff/cockpit/broka/scorecard", "destination": "/api/broka-desk?view=scorecard" },
    { "source": "/staff/cockpit/broka-jobs", "destination": "/api/broka/jobs" },
    { "source": "/staff/cockpit/broka/:caseRef", "destination": "/api/broka-desk?case=:caseRef" },
    { "source": "/staff/cockpit/pipeline", "destination": "/api/staff-pipeline" },
    { "source": "/staff/cockpit/spine/:caseRef", "destination": "/api/staff-cockpit?spine=:caseRef" },
    { "source": "/staff/cockpit", "destination": "/api/staff-cockpit" },
    { "source": "/staff/france/:caseId", "destination": "/api/fr-staff?caseId=:caseId" },
    { "source": "/staff/france", "destination": "/api/fr-staff" },
    { "source": "/staff/cases/:caseId/file/:submission", "destination": "/api/case-file?caseId=:caseId&submission=:submission&staff=1" },
    { "source": "/staff/cases/:caseId/export", "destination": "/api/case-export?caseId=:caseId" },
    { "source": "/staff/cases/:caseId", "destination": "/api/case-staff?caseId=:caseId" },
    { "source": "/staff/cases", "destination": "/api/case-staff" },
    {
      "source": "/apply/bh",
      "destination": "/apply?b=bh"
    },
    {
      "source": "/apply/byron",
      "destination": "/apply?b=bh"
    },
    {
      "source": "/apply/chris",
      "destination": "/apply?b=chris"
    },
    {
      "source": "/a/bh",
      "destination": "/apply?b=bh"
    },
    {
      "source": "/a/chris",
      "destination": "/apply?b=chris"
    },
    {
      "source": "/apply1",
      "destination": "/apply?b=chris"
    },
    { "source": "/api/forms/:form/:token/:action", "destination": "/api/smartlink-forms?form=:form&token=:token&action=:action" },
    { "source": "/api/forms/:form/:token", "destination": "/api/smartlink-forms?form=:form&token=:token" },
    { "source": "/works/:token/statement", "destination": "/smartlink/static" },
    { "source": "/works/:token", "destination": "/smartlink/static" },
    { "source": "/al/:token/statement", "destination": "/smartlink/static" },
    { "source": "/al/:token", "destination": "/smartlink/static" },
    { "source": "/remortgage/:token/summary", "destination": "/smartlink/static" },
    { "source": "/remortgage/:token", "destination": "/smartlink/static" },
    { "source": "/lender/:token/summary", "destination": "/smartlink/static" },
    { "source": "/lender/:token", "destination": "/smartlink/static" }
  ],
  "crons": [
    {
      "path": "/api/factfind-alert-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/verify-forms",
      "schedule": "*/30 * * * *"
    }
  ]
}
