{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/get-options",
      "destination": "/get-your-options",
      "permanent": false
    },
    {
      "source": "/go/options",
      "destination": "/get-your-options",
      "permanent": false
    },
    {
      "source": "/options",
      "destination": "/get-your-options",
      "permanent": false
    },
    {
      "source": "/development-exit",
      "destination": "/dev-exit",
      "permanent": false
    },
    {
      "source": "/development-exit-finance",
      "destination": "/dev-exit",
      "permanent": false
    },
    {
      "source": "/apply-now",
      "destination": "/apply",
      "permanent": false
    },
    {
      "source": "/go/speed",
      "destination": "/apply/speed",
      "permanent": false
    },
    {
      "source": "/go/bridge",
      "destination": "/apply/bridge",
      "permanent": false
    },
    {
      "source": "/go/dev",
      "destination": "/dev-exit",
      "permanent": false
    },
    {
      "source": "/go/senior",
      "destination": "/senior-desk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/engine/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/case/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/staff/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/case/:token/file/:submission", "destination": "/api/case-file?token=:token&submission=:submission" },
    { "source": "/case/:token/submit", "destination": "/api/case-submit?token=:token" },
    { "source": "/case/:token/kyc", "destination": "/api/case-kyc?token=:token" },
    { "source": "/case/:token", "destination": "/api/case-portal?token=:token" },
    { "source": "/staff/france/:caseId", "destination": "/api/fr-staff?caseId=:caseId" },
    { "source": "/staff/france", "destination": "/api/fr-staff" },
    { "source": "/staff/cases/:caseId/file/:submission", "destination": "/api/case-file?caseId=:caseId&submission=:submission&staff=1" },
    { "source": "/staff/cases/:caseId/export", "destination": "/api/case-export?caseId=:caseId" },
    { "source": "/staff/cases/:caseId", "destination": "/api/case-staff?caseId=:caseId" },
    { "source": "/staff/cases", "destination": "/api/case-staff" },
    {
      "source": "/apply/bh",
      "destination": "/apply?b=bh"
    },
    {
      "source": "/apply/byron",
      "destination": "/apply?b=bh"
    },
    {
      "source": "/apply/chris",
      "destination": "/apply?b=chris"
    },
    {
      "source": "/a/bh",
      "destination": "/apply?b=bh"
    },
    {
      "source": "/a/chris",
      "destination": "/apply?b=chris"
    },
    {
      "source": "/apply1",
      "destination": "/apply?b=chris"
    }
  ],
  "crons": [
    {
      "path": "/api/factfind-alert-worker",
      "schedule": "*/5 * * * *"
    }
  ]
}
